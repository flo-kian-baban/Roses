# Copy to .env.local (gitignored). Local Docker Postgres from docker-compose.yml (trust auth, no password).
DATABASE_URL=postgres://roses@127.0.0.1:5433/roses
# 32+ random bytes, base64 or hex. Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 when building a public-only output (admin routes return 404).
PREVIEW_BUILD=0
# Lockout (Kian's decision): 5 failures lock venue+address for 15 minutes; 50 per hour lock the venue. Override only for tests.
#LOCKOUT_FAILURES=5
#LOCKOUT_MINUTES=15
#VENUE_CAP_FAILURES=50
#VENUE_CAP_WINDOW_MINUTES=60
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For; the client address then comes from that header.
#TRUST_PROXY=0
# Set to 1 to add the Secure attribute to the session cookie when the app itself cannot tell it is behind https.
#COOKIE_SECURE=0
