{
  "name": "roses-menu",
  "private": true,
  "version": "0.1.0",
  "description": "Menu showcase and menu management for the Roses venues (Richmond Hill, Ontario)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "import": "node tools/import/run.mjs",
    "check:page": "node scripts/check-page.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:brand-words": "node scripts/check-brand-words.mjs .next/server/pages/senso.html .next/server/pages/kebab-land.html",
    "admin:create": "node scripts/admin-create.mjs",
    "uploads:clean": "node scripts/uploads-clean.mjs",
    "perf-fixture:verify": "node scripts/perf-fixture.mjs verify",
    "perf-fixture:freeze": "node scripts/perf-fixture.mjs freeze",
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full"
  },
  "dependencies": {
    "jose": "5.10.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.8.2",
    "playwright": "1.63.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
