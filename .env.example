# Copy to .env.local (gitignored). Local Docker Postgres from docker-compose.yml (trust auth, no password).
DATABASE_URL=postgres://roses@127.0.0.1:5433/roses
# 32+ random bytes, base64 or hex. Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: a new value, never the laptop's.
SESSION_SECRET=
# Lockout (Kian's decision): 5 failures lock venue+address for 15 minutes; 50 per hour on a venue raise an alert (the PM, 2026-11-03: no lock);
# 50 per hour across the venues pause admin PINs. Override only for tests; a value that is not a whole number counts as unset.
#LOCKOUT_FAILURES=5
#LOCKOUT_MINUTES=15
#VENUE_CAP_FAILURES=50
#VENUE_CAP_WINDOW_MINUTES=60
#ADMIN_PIN_CAP_FAILURES=50
#ADMIN_PIN_CAP_WINDOW_MINUTES=60
# The number of proxies in front of the app (1 on Vercel: required there); the client address is that many entries from the right of
# X-Forwarded-For (or of the header CLIENT_IP_HEADER names). Never set when the app is reached directly.
#TRUST_PROXY=0
#CLIENT_IP_HEADER=x-forwarded-for
# Set to 1 to add the Secure attribute to the session cookie when the app itself cannot tell it is behind https (production: 1).
#COOKIE_SECURE=0
# Uploaded photos and logos: the folder of the local disk driver (default ./uploads) and the driver (only "local" exists; it cannot work
# on Vercel, whose disk is read-only: the storage decision is Kian's, pre-go-live audit S1-24).
#UPLOAD_DIR=./uploads
#STORAGE_DRIVER=local
# Upload quota per venue (100 files an hour, 2000 files, 500 MB). Override only for tests.
#UPLOAD_QUOTA_HOUR=100
#UPLOAD_QUOTA_FILES=2000
#UPLOAD_QUOTA_MB=500
# The name each process gives itself in Postgres (the check suite sets it); leave unset.
#ROSES_APP_NAME=
# The check suite's own hooks, never set anywhere else: ROSES_NOW stands in for the clock (honoured only with ROSES_CHECK_SUITE=1), and
# ROSES_CHECK_SUITE=1 also turns on the admin API's test seams.
#ROSES_NOW=
#ROSES_CHECK_SUITE=
